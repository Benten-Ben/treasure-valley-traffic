{
  "name": "@sveltejs/adapter-node",
  "version": "6.0.0",
  "description": "Adapter for SvelteKit apps that generates a standalone Node server",
  "keywords": [
    "adapter",
    "deploy",
    "hosting",
    "node.js",
    "svelte",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/kit.git",
    "directory": "packages/adapter-node"
  },
  "license": "MIT",
  "homepage": "https://svelte.dev/docs/kit/adapter-node",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "index.d.ts",
  "files": [
    "src/*.js",
    "index.js",
    "index.d.ts",
    "ambient.d.ts"
  ],
  "devDependencies": {
    "@sveltejs/kit": "^3.0.0",
    "@types/node": "^22.19.19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0-next.0"
  },
  "scripts": {
    "test": "pnpm test:unit && pnpm test:build",
    "test:unit": "vitest run",
    "test:build": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test:build",
    "check": "node node_modules/@typescript/native/bin/tsc",
    "lint": "oxfmt --check .",
    "format": "oxfmt --write ."
  }
}