{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"perf": "node scripts/perf.mjs",
		"seed": "node scripts/seed-dev.ts",
		"db": "node scripts/db.mjs",
		"bundle-budget": "node scripts/bundle-budget.mjs",
		"dev:wp": "node scripts/harness-env.mjs -- vite dev --port {port} --strictPort",
		"preview:wp": "node scripts/e2e-server.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.56.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.1",
		"sirv": "^3.0.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/fredoka": "^5.3.0",
		"@fontsource/overpass": "^5.3.0",
		"@fontsource/overpass-mono": "^5.3.0",
		"@protomaps/basemaps": "^5.7.2",
		"maplibre-gl": "^6.12.0",
		"pmtiles": "^4.5.0",
		"postgres": "^3.4.9"
	}
}
