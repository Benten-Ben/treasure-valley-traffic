# Camera videos older than the days the VM keeps to off-site storage (decision A1, as changed
# Oct 30, 2026): deploy/bin/cold-videos, started daily by tvt-cold-videos.timer. Install:
# deploy/README.md, "Older camera videos go off-site".
[Unit]
Description=Treasure Valley Traffic: older camera videos to off-site storage
Documentation=https://github.com/Benten-Ben/treasure-valley-traffic/blob/main/deploy/README.md
After=local-fs.target remote-fs.target network-online.target
Wants=network-online.target
ConditionPathExists=/srv/tvt/work/bin/cold-videos

[Service]
Type=oneshot
# The camera archive's owner (uid 1000, as the capture containers run), so it may replace
# files there; the SSH key to the off-site storage (OFFSITE_SSH in heavy.conf) is readable
# by it alone. ProtectHome hides its home folder: OFFSITE_SSH names its own key and known
# host in /srv/tvt/work/offsite, and no ssh config.
User=1000
Group=1000
UMask=0002
# Wait up to 5 hours for tonight's roll-up to finish; it reads its rules and settings from
# heavy and heavy.conf beside it in /srv/tvt/work.
ExecStart=/srv/tvt/work/bin/cold-videos --wait 300
# 75: not now (the roll-up ran late, a restart is planned); the next day's run catches up.
# 69 (the off-site storage can't be reached) is a failure: status flags it.
SuccessExitStatus=75
TimeoutStartSec=7h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
