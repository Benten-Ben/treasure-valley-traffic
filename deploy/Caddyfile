{
	# Plain HTTP on the LAN port, plus HTTPS on the tailnet name (HTTP/2 and
	# HTTP/3, so map tiles load in parallel). No HTTP-to-HTTPS redirect: the
	# LAN address keeps working as before.
	auto_https disable_redirects
	admin off
}

(site) {
	# The app to proxy to is the snippet's argument: app:3000 for the live
	# app, app-next:3000 for the preview (compose.preview.yml).
	# Basemap output from basemap/ (PMTiles, fonts, sprites, manifest.json).
	# file_server answers HTTP range requests, which PMTiles depends on.
	handle_path /tiles/* {
		root * /srv/tiles
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# The camera video library (deploy/library/). The videos are 511 Idaho's
	# pictures, so the site stays on the LAN and tailnet. Videos and their
	# picture-time CSVs come read-only from the archive; the frame streams
	# rewrite the index-*.json files after each roll-up.
	redir /videos /videos/
	handle_path /videos/files/* {
		root * /srv/videos
		encode zstd gzip
		@index path /index-*.json
		@media not path /index-*.json
		header @index Cache-Control "no-cache"
		header @media Cache-Control "public, max-age=3600"
		file_server browse
	}
	handle_path /videos/* {
		root * /srv/library
		encode zstd gzip
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		encode zstd gzip
		reverse_proxy {args[0]}
	}
}

:80 {
	import site app:3000
}

# The VM's Tailscale name (TVT_HTTPS_HOST in deploy/.env, kept out of the
# repo). Caddy gets its certificate from the VM's Tailscale daemon through the
# mounted socket; the tailnet must have HTTPS certificates switched on.
{$TVT_HTTPS_HOST:localhost} {
	import site app:3000
}

# The preview of main's app (compose.preview.yml publishes these ports; without
# it they stay inside the container and app-next doesn't exist).
:81 {
	import site app-next:3000
}

{$TVT_HTTPS_HOST:localhost}:8444 {
	import site app-next:3000
}
