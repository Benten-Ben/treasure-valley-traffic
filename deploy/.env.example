# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored;
# never commit it or paste its contents into a chat session.

# Database password: generate one on the server with `openssl rand -hex 24`
# (hex only: base64's / and + would break the database URL).
POSTGRES_PASSWORD=

# Where the basemap builds wrote their output on the server.
TILES_DIR=/srv/tvt/tiles

# Captured camera frames (calibration references). Must be writable by uid 1000:
#   sudo mkdir -p /srv/tvt/frames && sudo chown 1000:1000 /srv/tvt/frames
FRAMES_DIR=/srv/tvt/frames

# Private reference files (third-party copies kept out of the repository), mounted
# read-only into the ingest service for one-off sources.
PRIVATE_DATA_DIR=/srv/tvt/private/data

# Raw feed archive: the record of truth for streamed sources (VRT GTFS-realtime).
# Must be writable by uid 1000:
#   sudo mkdir -p /srv/tvt/archive && sudo chown 1000:1000 /srv/tvt/archive
ARCHIVE_DIR=/srv/tvt/archive

# 511 Idaho API key (the idaho511 service). Secret: only in deploy/.env on the server.
IDAHO511_API_KEY=

# Address and port the web server listens on, on the VM.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# HTTPS on the tailnet (HTTP/2 and HTTP/3): the VM's full Tailscale name, e.g.
# <machine>.<tailnet>.ts.net. Needs HTTPS certificates switched on in the
# Tailscale admin console. Private: keep it out of the repository.
TVT_HTTPS_HOST=
HTTPS_BIND=0.0.0.0
