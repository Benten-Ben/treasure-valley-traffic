{
  "about": [
    "Shared cases for the rules-by-date evaluator (ingest/seasons.py; docs/17 §17.8 Q2).",
    "Any twin of the evaluator must give the same answers. Times without an offset are Boise local time;",
    "a date alone is its local midnight. 'at' lists [moment, the value expected, and optionally the winning rule's id].",
    "'timeline' gives a start and an end (excluded) and the spans expected, end to end, as",
    "[start, end, value, the winning rule's id], with null where no rule is in force.",
    "'invalid' lists rules that must be refused. The places and rules are made up."
  ],
  "cases": [
    {
      "name": "a dated window includes its end day",
      "rules": [{"id": "w", "level": "seasonal", "value": "on", "dates": {"start": "2026-04-06", "end": "2026-10-15"}}],
      "at": [["2026-04-05T23:59", null], ["2026-04-06T00:00", "on", "w"], ["2026-10-15T23:59", "on"],
             ["2026-10-16T00:00", null]]
    },
    {
      "name": "a dated window with times excludes its end, and Z or an offset is absolute",
      "rules": [{"id": "g", "level": "order", "value": "on",
                 "dates": {"start": "2026-04-06T10:15", "end": "2026-09-28T14:00Z"}}],
      "at": [["2026-04-06T10:14", null], ["2026-04-06T10:15", "on"], ["2026-04-06T16:15Z", "on"],
             ["2026-09-28T07:59", "on"], ["2026-09-28T08:00", null], ["2026-09-28T08:00-06:00", null]]
    },
    {
      "name": "either end of a window may be open",
      "rules": [{"id": "since", "level": "order", "value": "off", "dates": {"start": "2026-09-28T08:00"}},
                {"id": "until", "level": "seasonal", "value": "old", "dates": {"end": "2020-12-31"}}],
      "at": [["2026-09-28T07:59", null], ["2035-01-01", "off"], ["1990-06-01", "old"], ["2021-01-01", null]]
    },
    {
      "name": "a yearly window, every year",
      "rules": [{"id": "y", "level": "seasonal", "value": "on", "yearly": {"start": "04-01", "end": "10-31"}}],
      "at": [["2026-03-31T23:59", null], ["2026-04-01T00:00", "on"], ["2027-10-31T23:59", "on"],
             ["2027-11-01T00:00", null], ["2031-07-04T12:00", "on"]]
    },
    {
      "name": "a yearly window wraps past New Year",
      "rules": [{"id": "leash", "level": "seasonal", "value": "leashed", "yearly": {"start": "11-16", "end": "04-30"}}],
      "at": [["2026-11-15T23:59", null], ["2026-11-16T00:00", "leashed"], ["2026-12-31T23:59", "leashed"],
             ["2027-01-01T00:00", "leashed"], ["2027-04-30T23:59", "leashed"], ["2027-05-01T00:00", null]],
      "timeline": {"start": "2026-11-01", "end": "2027-06-01",
                   "spans": [["2026-11-01", "2026-11-16", null, null],
                             ["2026-11-16", "2027-05-01", "leashed", "leash"],
                             ["2027-05-01", "2027-06-01", null, null]]}
    },
    {
      "name": "Feb 29 exists only in leap years",
      "rules": [{"id": "late", "level": "seasonal", "value": "late Feb", "yearly": {"start": "02-20", "end": "02-29"}},
                {"id": "leap", "level": "seasonal", "value": "leap day", "yearly": {"start": "02-29", "end": "02-29"}}],
      "at": [["2028-02-29T12:00", "leap day"], ["2027-02-28T12:00", "late Feb"], ["2027-03-01T00:00", null],
             ["2028-02-28T23:59", "late Feb"], ["2028-03-01T00:00", null]]
    },
    {
      "name": "weekdays",
      "rules": [{"id": "we", "level": "seasonal", "value": "weekend", "weekdays": ["SA", "SU"]}],
      "at": [["2026-10-09T23:59", null], ["2026-10-10T00:00", "weekend"], ["2026-10-11T23:59", "weekend"],
             ["2026-10-12T00:00", null]],
      "timeline": {"start": "2026-10-08", "end": "2026-10-13",
                   "spans": [["2026-10-08", "2026-10-10", null, null],
                             ["2026-10-10", "2026-10-12", "weekend", "we"],
                             ["2026-10-12", "2026-10-13", null, null]]}
    },
    {
      "name": "odd days follow the Boise date, so the 31st and the 1st are both odd",
      "rules": [{"id": "odd", "level": "seasonal", "value": "downhill", "monthdays": "odd"}],
      "at": [["2026-07-31T12:00", "downhill"], ["2026-08-01T12:00", "downhill"], ["2026-08-02T12:00", null],
             ["2026-08-01T05:30Z", "downhill"], ["2026-08-02T05:30Z", "downhill"], ["2026-08-02T06:30Z", null]],
      "timeline": {"start": "2026-07-30", "end": "2026-08-04",
                   "spans": [["2026-07-30", "2026-07-31", null, null],
                             ["2026-07-31", "2026-08-02", "downhill", "odd"],
                             ["2026-08-02", "2026-08-03", null, null],
                             ["2026-08-03", "2026-08-04", "downhill", "odd"]]}
    },
    {
      "name": "even days and a list of days",
      "rules": [{"id": "even", "level": "seasonal", "value": "even", "monthdays": "even"},
                {"id": "mid", "level": "closure", "value": "the 15th", "monthdays": [15]}],
      "at": [["2026-02-28T12:00", "even"], ["2026-03-01T12:00", null], ["2026-03-15T12:00", "the 15th"],
             ["2026-03-16T12:00", "even"]]
    },
    {
      "name": "hours that run past midnight belong to the day they start",
      "rules": [{"id": "fri", "level": "closure", "value": "closed", "weekdays": ["FR"],
                 "hours": {"start": "22:00", "end": "02:00"}}],
      "at": [["2026-10-16T21:59", null], ["2026-10-16T22:00", "closed"], ["2026-10-17T01:59", "closed"],
             ["2026-10-17T02:00", null], ["2026-10-17T23:00", null]],
      "timeline": {"start": "2026-10-17T00:00", "end": "2026-10-18",
                   "spans": [["2026-10-17T00:00", "2026-10-17T02:00", "closed", "fri"],
                             ["2026-10-17T02:00", "2026-10-18", null, null]]}
    },
    {
      "name": "hours inside a yearly window, and 24:00",
      "rules": [{"id": "day", "level": "seasonal", "value": "open", "yearly": {"start": "06-01", "end": "08-31"},
                 "hours": {"start": "06:00", "end": "22:00"}},
                {"id": "eve", "level": "seasonal", "value": "evening", "yearly": {"start": "06-01", "end": "08-31"},
                 "hours": {"start": "22:00", "end": "24:00"}}],
      "at": [["2026-06-01T05:59", null], ["2026-06-01T06:00", "open"], ["2026-08-31T21:59", "open"],
             ["2026-08-31T22:00", "evening"], ["2026-08-31T23:59", "evening"], ["2026-09-01T00:00", null],
             ["2026-09-01T07:00", null]],
      "timeline": {"start": "2026-07-04", "end": "2026-07-05T12:00",
                   "spans": [["2026-07-04T00:00", "2026-07-04T06:00", null, null],
                             ["2026-07-04T06:00", "2026-07-04T22:00", "open", "day"],
                             ["2026-07-04T22:00", "2026-07-05T00:00", "evening", "eve"],
                             ["2026-07-05T00:00", "2026-07-05T06:00", null, null],
                             ["2026-07-05T06:00", "2026-07-05T12:00", "open", "day"]]}
    },
    {
      "name": "the last day of a yearly window can run past New Year by its hours",
      "rules": [{"id": "nye", "level": "seasonal", "value": "fireworks", "yearly": {"start": "12-31", "end": "12-31"},
                 "hours": {"start": "22:00", "end": "02:00"}}],
      "at": [["2026-12-30T23:00", null], ["2026-12-31T21:59", null], ["2026-12-31T23:00", "fireworks"],
             ["2027-01-01T01:59", "fireworks"], ["2027-01-01T02:00", null], ["2027-01-01T23:00", null]]
    },
    {
      "name": "hours alone recur every day",
      "rules": [{"id": "night", "level": "closure", "value": "closed", "hours": {"start": "23:00", "end": "05:00"}}],
      "at": [["2026-10-10T22:59", null], ["2026-10-10T23:00", "closed"], ["2026-10-11T04:59", "closed"],
             ["2026-10-11T05:00", null]],
      "timeline": {"start": "2026-10-10T12:00", "end": "2026-10-12T12:00",
                   "spans": [["2026-10-10T12:00", "2026-10-10T23:00", null, null],
                             ["2026-10-10T23:00", "2026-10-11T05:00", "closed", "night"],
                             ["2026-10-11T05:00", "2026-10-11T23:00", null, null],
                             ["2026-10-11T23:00", "2026-10-12T05:00", "closed", "night"],
                             ["2026-10-12T05:00", "2026-10-12T12:00", null, null]]}
    },
    {
      "name": "a dated order beats a closure, which beats a seasonal rule, which beats the default",
      "rules": [{"id": "s", "level": "seasonal", "value": "closed for wildlife", "yearly": {"start": "02-01", "end": "04-14"}},
                {"id": "o", "level": "order", "value": "open by order", "dates": {"start": "2026-03-05", "end": "2026-03-06"}},
                {"id": "d", "level": "default", "value": "open"},
                {"id": "c", "level": "closure", "value": "closed for fire", "dates": {"start": "2026-03-01", "end": "2026-03-10"}}],
      "at": [["2026-01-15T12:00", "open", "d"], ["2026-02-15T12:00", "closed for wildlife", "s"],
             ["2026-03-02T12:00", "closed for fire", "c"], ["2026-03-05T12:00", "open by order", "o"],
             ["2026-03-07T12:00", "closed for fire", "c"], ["2026-03-11T12:00", "closed for wildlife", "s"],
             ["2026-04-15T12:00", "open", "d"]],
      "timeline": {"start": "2026-01-25", "end": "2026-04-20",
                   "spans": [["2026-01-25", "2026-02-01", "open", "d"],
                             ["2026-02-01", "2026-03-01", "closed for wildlife", "s"],
                             ["2026-03-01", "2026-03-05", "closed for fire", "c"],
                             ["2026-03-05", "2026-03-07", "open by order", "o"],
                             ["2026-03-07", "2026-03-11", "closed for fire", "c"],
                             ["2026-03-11", "2026-04-15", "closed for wildlife", "s"],
                             ["2026-04-15", "2026-04-20", "open", "d"]]}
    },
    {
      "name": "within a level the rule listed later wins",
      "rules": [{"id": "season", "level": "seasonal", "value": "on", "yearly": {"start": "04-01", "end": "10-31"}},
                {"id": "drought", "level": "seasonal", "value": "off", "dates": {"start": "2026-07-01", "end": "2026-07-31"}}],
      "at": [["2026-06-30T12:00", "on", "season"], ["2026-07-15T12:00", "off", "drought"],
             ["2026-08-01T12:00", "on", "season"]]
    },
    {
      "name": "within a level the rule listed later wins, the other way round",
      "rules": [{"id": "drought", "level": "seasonal", "value": "off", "dates": {"start": "2026-07-01", "end": "2026-07-31"}},
                {"id": "season", "level": "seasonal", "value": "on", "yearly": {"start": "04-01", "end": "10-31"}}],
      "at": [["2026-07-15T12:00", "on", "season"]]
    },
    {
      "name": "dates on a recurring rule say which occurrences happen, by the day they start",
      "rules": [{"id": "june", "level": "seasonal", "value": "open", "weekdays": ["SA", "SU"],
                 "dates": {"start": "2026-06-06", "end": "2026-06-14"}}],
      "at": [["2026-05-31T12:00", null], ["2026-06-06T00:00", "open", "june"], ["2026-06-14T23:59", "open"],
             ["2026-06-20T12:00", null]],
      "timeline": {"start": "2026-06-01", "end": "2026-06-22",
                   "spans": [["2026-06-01", "2026-06-06", null, null],
                             ["2026-06-06", "2026-06-08", "open", "june"],
                             ["2026-06-08", "2026-06-13", null, null],
                             ["2026-06-13", "2026-06-15", "open", "june"],
                             ["2026-06-15", "2026-06-22", null, null]]}
    },
    {
      "name": "the last occurrence before a dated end runs whole, past midnight (UNTIL)",
      "rules": [{"id": "fri", "level": "closure", "value": "closed", "weekdays": ["FR"],
                 "hours": {"start": "22:00", "end": "02:00"}, "dates": {"end": "2026-06-26"},
                 "text": "Friday night closures through June 26"}],
      "at": [["2026-06-20T01:00", "closed"], ["2026-06-26T23:00", "closed", "fri"], ["2026-06-27T01:59", "closed"],
             ["2026-06-27T02:00", null], ["2026-07-03T23:00", null], ["2026-07-04T01:00", null]],
      "timeline": {"start": "2026-06-26T12:00", "end": "2026-06-28",
                   "spans": [["2026-06-26T12:00", "2026-06-26T22:00", null, null],
                             ["2026-06-26T22:00", "2026-06-27T02:00", "closed", "fri"],
                             ["2026-06-27T02:00", "2026-06-28", null, null]]}
    },
    {
      "name": "an occurrence that starts before a dated start doesn't count (DTSTART)",
      "rules": [{"id": "night", "level": "closure", "value": "closed", "hours": {"start": "22:00", "end": "02:00"},
                 "dates": {"start": "2026-06-20"}}],
      "at": [["2026-06-19T23:00", null], ["2026-06-20T01:00", null], ["2026-06-20T21:59", null],
             ["2026-06-20T22:00", "closed", "night"], ["2026-06-21T01:59", "closed"]],
      "timeline": {"start": "2026-06-19T12:00", "end": "2026-06-21T12:00",
                   "spans": [["2026-06-19T12:00", "2026-06-20T22:00", null, null],
                             ["2026-06-20T22:00", "2026-06-21T02:00", "closed", "night"],
                             ["2026-06-21T02:00", "2026-06-21T12:00", null, null]]}
    },
    {
      "name": "dates given as moments bound occurrence starts and never cut one short",
      "rules": [{"id": "wknd", "level": "seasonal", "value": "open", "weekdays": ["SA", "SU"],
                 "dates": {"start": "2026-06-06T12:00", "end": "2026-06-13T12:00"}}],
      "at": [["2026-06-06T12:00", null], ["2026-06-06T23:59", null], ["2026-06-07T00:00", "open", "wknd"],
             ["2026-06-13T18:00", "open"], ["2026-06-14T12:00", null]],
      "timeline": {"start": "2026-06-06", "end": "2026-06-15",
                   "spans": [["2026-06-06", "2026-06-07", null, null],
                             ["2026-06-07", "2026-06-08", "open", "wknd"],
                             ["2026-06-08", "2026-06-13", null, null],
                             ["2026-06-13", "2026-06-14", "open", "wknd"],
                             ["2026-06-14", "2026-06-15", null, null]]}
    },
    {
      "name": "a day across the spring change lasts 23 hours",
      "rules": [{"id": "sun", "level": "seasonal", "value": "on", "dates": {"start": "2026-03-08", "end": "2026-03-08"}}],
      "timeline": {"start": "2026-03-07", "end": "2026-03-10",
                   "spans": [["2026-03-07T00:00-07:00", "2026-03-08T00:00-07:00", null, null],
                             ["2026-03-08T00:00-07:00", "2026-03-09T00:00-06:00", "on", "sun"],
                             ["2026-03-09T00:00-06:00", "2026-03-10T00:00-06:00", null, null]]}
    },
    {
      "name": "a day across the autumn change lasts 25 hours",
      "rules": [{"id": "sun", "level": "seasonal", "value": "on", "weekdays": ["SU"]}],
      "timeline": {"start": "2026-10-31", "end": "2026-11-03",
                   "spans": [["2026-10-31T00:00-06:00", "2026-11-01T00:00-06:00", null, null],
                             ["2026-11-01T00:00-06:00", "2026-11-02T00:00-07:00", "on", "sun"],
                             ["2026-11-02T00:00-07:00", "2026-11-03T00:00-07:00", null, null]]}
    },
    {
      "name": "a local time the spring change skips is read with the offset before it",
      "rules": [{"id": "h", "level": "closure", "value": "closed", "hours": {"start": "01:30", "end": "02:30"}}],
      "at": [["2026-03-08T01:29-07:00", null], ["2026-03-08T01:30-07:00", "closed"],
             ["2026-03-08T03:29-06:00", "closed"], ["2026-03-08T03:30-06:00", null]],
      "timeline": {"start": "2026-03-08", "end": "2026-03-08T06:00",
                   "spans": [["2026-03-08T00:00-07:00", "2026-03-08T01:30-07:00", null, null],
                             ["2026-03-08T01:30-07:00", "2026-03-08T03:30-06:00", "closed", "h"],
                             ["2026-03-08T03:30-06:00", "2026-03-08T06:00-06:00", null, null]]}
    },
    {
      "name": "a local time the autumn change repeats is its first reading",
      "rules": [{"id": "h", "level": "closure", "value": "closed", "hours": {"start": "01:00", "end": "01:30"}}],
      "at": [["2026-11-01T00:59-06:00", null], ["2026-11-01T01:15-06:00", "closed"],
             ["2026-11-01T01:30-06:00", null], ["2026-11-01T01:15-07:00", null]]
    },
    {
      "name": "no rules, no answer",
      "rules": [],
      "at": [["2026-10-10T12:00", null]],
      "timeline": {"start": "2026-10-10", "end": "2026-10-11", "spans": [["2026-10-10", "2026-10-11", null, null]]}
    },
    {
      "name": "a default is always in force",
      "rules": [{"id": "d", "level": "default", "value": "unknown"}],
      "at": [["1970-01-01T00:00Z", "unknown"], ["2099-12-31T23:59", "unknown"]],
      "timeline": {"start": "2026-10-10", "end": "2026-10-11", "spans": [["2026-10-10", "2026-10-11", "unknown", "d"]]}
    },
    {
      "name": "values can be any JSON but null",
      "rules": [{"id": "d", "level": "default", "value": {"bikes": "both ways", "dogs": "leashed"}},
                {"id": "f", "level": "closure", "value": false, "weekdays": ["MO"]}],
      "at": [["2026-10-10T12:00", {"bikes": "both ways", "dogs": "leashed"}], ["2026-10-12T12:00", false, "f"]]
    }
  ],
  "invalid": [
    {"why": "an unknown key", "rule": {"level": "seasonal", "value": "on", "wekdays": ["SA"]}},
    {"why": "an unknown level", "rule": {"level": "advisory", "value": "on"}},
    {"why": "no level", "rule": {"value": "on"}},
    {"why": "no value", "rule": {"level": "seasonal", "dates": {"start": "2026-04-01"}}},
    {"why": "a null value", "rule": {"level": "seasonal", "value": null}},
    {"why": "dates that end before they start", "rule": {"level": "order", "value": "on", "dates": {"start": "2026-04-06", "end": "2026-04-05"}}},
    {"why": "an empty window", "rule": {"level": "order", "value": "on", "dates": {"start": "2026-04-06T10:00", "end": "2026-04-06T10:00"}}},
    {"why": "dates with neither end", "rule": {"level": "order", "value": "on", "dates": {}}},
    {"why": "dates with another key", "rule": {"level": "order", "value": "on", "dates": {"start": "2026-04-06", "until": "2026-05-01"}}},
    {"why": "a date that isn't one", "rule": {"level": "order", "value": "on", "dates": {"start": "April 6"}}},
    {"why": "a compact ISO date, which Python would read as a midnight moment",
     "rule": {"level": "order", "value": "on", "dates": {"start": "2026-04-06", "end": "20260407"}}},
    {"why": "an ISO week date", "rule": {"level": "order", "value": "on", "dates": {"start": "2026-W15-1"}}},
    {"why": "a date and time without minutes", "rule": {"level": "order", "value": "on", "dates": {"start": "2026-04-06T10"}}},
    {"why": "a yearly day without its leading zero", "rule": {"level": "seasonal", "value": "on", "yearly": {"start": "4-01", "end": "10-31"}}},
    {"why": "a yearly day that doesn't exist", "rule": {"level": "seasonal", "value": "on", "yearly": {"start": "02-30", "end": "10-31"}}},
    {"why": "a yearly window with one end", "rule": {"level": "seasonal", "value": "on", "yearly": {"start": "04-01"}}},
    {"why": "a weekday that isn't an RFC 5545 code", "rule": {"level": "seasonal", "value": "on", "weekdays": ["Sat"]}},
    {"why": "no weekdays", "rule": {"level": "seasonal", "value": "on", "weekdays": []}},
    {"why": "a day of the month past 31", "rule": {"level": "seasonal", "value": "on", "monthdays": [32]}},
    {"why": "day 0", "rule": {"level": "seasonal", "value": "on", "monthdays": [0]}},
    {"why": "monthdays as a word other than odd or even", "rule": {"level": "seasonal", "value": "on", "monthdays": "first"}},
    {"why": "an hour past 24", "rule": {"level": "seasonal", "value": "on", "hours": {"start": "06:00", "end": "25:00"}}},
    {"why": "24:00 as a start", "rule": {"level": "seasonal", "value": "on", "hours": {"start": "24:00", "end": "06:00"}}},
    {"why": "an hour without its leading zero", "rule": {"level": "seasonal", "value": "on", "hours": {"start": "6:00", "end": "22:00"}}},
    {"why": "hours with one end", "rule": {"level": "seasonal", "value": "on", "hours": {"end": "22:00"}}},
    {"why": "an id that isn't text", "rule": {"id": 7, "level": "seasonal", "value": "on"}}
  ]
